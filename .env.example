# Chave da API do Google Gemini
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# Modelo Gemini (recomendado: gemini-3.6-flash ou gemini-3.7-flash)
GEMINI_MODEL=gemini-3.6-flash

# Janela padrão em horas para notícias matinais (ex: 16 horas para cobrir a madrugada)
BRIEFING_HOURS=16

# Idioma do relatório final
BRIEFING_LANGUAGE=pt-BR

# Pasta onde os relatórios serão gravados (padrão: pasta reports na raiz)
# REPORTS_DIR=C:/Users/mlori/Documents/Noticias

# Integração Gratuita com WhatsApp (CallMeBot)
# 1. Envie mensagem no WhatsApp para o bot: I allow callmebot to send me messages
# 2. Insira o telefone (DDI + DDD + número, ex: 5541999999999) e a apikey recebida
WHATSAPP_ENABLED=false
WHATSAPP_PHONE=5541999999999
WHATSAPP_APIKEY=sua_apikey_aqui
